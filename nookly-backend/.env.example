# Nookly backend environment variables
# Copy to `.env` for LOCAL DEV ONLY (this file is gitignored). In production
# (Render) set ALL of these in the service's Environment Variables panel — do NOT
# commit real values, and pushing this repo never changes them.
#
# ── DEV vs PROD ──────────────────────────────────────────────────────────────
# Local dev  : this `.env` uses a LOCAL Postgres (see docker-compose.yml), so
#              tests never touch the live database.
# Production : Render supplies these same vars via its dashboard. Local changes
#              here have zero effect on the hosted server.

# LOCAL PostgreSQL (used by docker-compose.yml). For a hosted Postgres/Neon, set
# DATABASE_URL to the pooled connection URL with ?sslmode=require, e.g.:
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/nookly?sslmode=require
DATABASE_URL=postgresql://nookly:nookly_dev_password@localhost:5432/nookly

# Keep your production (Neon) connection string here for reference only — it is
# NEVER read by the app (Prisma uses DATABASE_URL above). Use it when you need to
# run a one-off migration/query against prod from a safe, deliberate context.
# DATABASE_URL_NEON=postgresql://neondb_owner:xxxx@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Auth secret (min 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-at-least-32-characters

# Port the server listens on. Render assigns this dynamically via PORT — leave
# unset (or 3000) locally; never hardcode a fixed value in production.
PORT=4000

# Admin seed user (used by: npx prisma db seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Email (Resend). Leave RESEND_API_KEY empty to fall back to console logging.
RESEND_API_KEY=
EMAIL_FROM=nookly@example.com
SUPPORT_EMAIL=support@example.com

# Allowed browser origins (CORS) AND the base URL used in emailed links.
# Comma-separated for multiple. MUST be the real deployed frontend origin
# (e.g. https://nookly.vercel.app). In production a localhost value is rejected
# at boot. For local dev use http://localhost:3000 (the Next dev server).
FRONTEND_URL=http://localhost:3000

# KYC document encryption key — base64-encoded 32 bytes. Generate:
#   openssl rand -base64 32
KYC_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key

# --- Cloudflare R2 (S3-compatible) object storage ---
# R2 endpoint is derived as: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Public bucket: business/service photos, avatars, category icons, intro video.
R2_BUCKET_PUBLIC=nookly-public
# Private bucket: KYC documents (selfie, certificate, proof of address).
R2_BUCKET_PRIVATE=nookly-private
# Public base URL for the public bucket — either the R2 dev URL
# (<account>.r2.cloudflarestorage.com/<bucket>) or a custom domain / R2.dev
# public bucket URL. Uploaded public files are served as <R2_PUBLIC_URL>/<key>.
R2_PUBLIC_URL=https://pub-<hash>.r2.cloudflarestorage.com/nookly-public
