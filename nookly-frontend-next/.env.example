# Backend API origin.
# All /api calls and the real-time socket.io connection are derived from this.
# No trailing slash.
#
# - LOCAL DEV: create `.env.local` (gitignored) with
#     NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
#   so the local frontend talks to your local backend only.
# - PRODUCTION: set this at build time (Vercel/Render env) to the hosted backend,
#   e.g. https://nookly-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://your-backend-host.example.com
